{
  "mcpServers": {
    "datashield": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/obiba/datashield-mcp",
        "datashield-mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "r-mcptools": {
      "type": "stdio",
      "command": "Rscript",
      "args": [
        "-e",
        "mcptools::mcp_server(tools = btw::btw_tools(c(\"docs\", \"pkg\", \"env\", \"sessioninfo\", \"cran\")))"
      ]
    }
  }
}
