{
  "mcpServers": {
    "datashield": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/obiba/datashield-mcp",
        "datashield-mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "r-mcptools": {
      "type": "stdio",
      "command": "Rscript",
      "args": [
        "-e",
        "mcptools::mcp_server(tools = btw::btw_tools(c(\"docs\", \"pkg\", \"env\", \"sessioninfo\", \"cran\")))"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headersHelper": "printf '{\"Authorization\":\"Bearer %s\"}' \"$(gh auth token)\""
    },
    "mlflow-mcp": {
      "command": "uv",
      "args": ["run", "--with", "mlflow[mcp]>=3.5.1", "mlflow", "mcp", "run"],
      "env": {
        "MLFLOW_TRACKING_URI": "http://localhost:5050"
      }
    }
    
  }
}
